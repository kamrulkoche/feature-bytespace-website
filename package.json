{
    "name": "public-next-app",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3000",
        "build": "next build",
        "start": "next start -p 3000",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format:css": "prettier --write \"styles/**/*.css\"",
        "format:ts": "prettier --write \"src/**/*.{ts,tsx}\"",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "test:watch": "jest --watchAll"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@monaco-editor/react": "^4.6.0",
        "@reduxjs/toolkit": "^2.9.0",
        "axios": "^1.20.0",
        "buffer": "^6.0.3",
        "date-fns": "^2.29.3",
        "disable-devtool": "^0.3.7",
        "husky": "^9.1.7",
        "i18next": "^25.5.2",
        "lucide-react": "^0.542.0",
        "next": "^15.5.26",
        "next-i18next": "^15.4.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-i18next": "^15.7.3",
        "react-redux": "^9.2.0",
        "react-slick": "^0.30.3",
        "redux-saga": "^1.2.3",
        "slick-carousel": "^1.8.1",
        "typed-redux-saga": "^1.5.0",
        "vcard-creator": "^0.7.1"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^20",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "autoprefixer": "^10.4.21",
        "@eslint/eslintrc": "^3.3.7",
        "eslint": "^9.39.5",
        "eslint-config-next": "15.5.26",
        "eslint-plugin-jest-dom": "^5.5.0",
        "eslint-plugin-testing-library": "^7.8.0",
        "jest": "^30.1.3",
        "jest-environment-jsdom": "^30.1.2",
        "postcss": "^8.5.28",
        "prettier": "^3.6.2",
        "sass": "^1.70.0",
        "tailwindcss": "^3.4.1",
        "ts-jest": "^29.4.4",
        "typescript": "^5.4.4"
    },
    "overrides": {
        "i18next-fs-backend": "^2.6.8",
        "handlebars": "^4.7.9",
        "postcss": "^8.5.28"
    },
    "lint-staged": {
        "*.{ts,tsx}": "eslint --cache --fix",
        "*.{ts,tsx,css,scss,md}": "prettier --write . \"!**/*.{.json}\" --ignore-path .gitignore ."
    },
    "husky": {
        "hooks": {
            "pre-commit": "npm run precommit"
        }
    }
}
